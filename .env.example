# ============================================
# Application Configuration
# ============================================
APP_NAME=SupportAI
APP_ENV=development
DEBUG=true

# ============================================
# Backend API Configuration
# ============================================
API_HOST=0.0.0.0
API_PORT=8000

# ============================================
# Database Configuration (PostgreSQL + pgvector)
# ============================================
DATABASE_URL=postgresql+asyncpg://supportai:supportai_dev@localhost:5432/supportai

# ============================================
# Redis Configuration (Job Queue Broker)
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# AI / LLM Configuration (Local Ollama)
# ============================================
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text

# ============================================
# File Storage Configuration
# ============================================
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

# ============================================
# Security Configuration
# ============================================
SECRET_KEY=change-me-to-a-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
